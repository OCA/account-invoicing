<odoo>
    <record id="action_billing_summary_wizard" model="ir.actions.act_window">
        <field name="name">Billing Summary</field>
        <field name="res_model">billing.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_billing_summary_wizard_form" model="ir.ui.view">
        <field name="name">billing.summary.wizard.form</field>
        <field name="model">billing.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Billing Summary">
                <sheet>
                    <group>
                        <group name="date_range_group">
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                        <group name="customer_group">
                            <field name="customer_ids" widget="many2many_tags" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', allowed_company_ids)]"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Export to Excel"
                        name="action_export_excel"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
