<odoo>
    <record id="view_account_move_send_form_mass_sending" model="ir.ui.view">
        <field name="name">account.move.send - Mass sending</field>
        <field name="model">account.move.send</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Send Move">
                <sheet>
                    <group>
                        <field name="checkbox_send_mail" widget="boolean" />
                        <field name="mail_template_id" 
                               attrs="{'required': [('checkbox_send_mail', '=', True)]}"
                               options="{'no_open': True}" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="enqueue_invoices"
                        string="📧 Email mass sending (Job Queue)"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('checkbox_send_mail', '=', False)]}"
                    />
                    <button
                        name="action_send_and_print"
                        string="Send &amp; Print"
                        type="object"
                        class="btn-secondary"
                    />
                    <button string="Cancel" class="btn-link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>