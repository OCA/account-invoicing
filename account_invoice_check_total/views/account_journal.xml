<odoo>

    <record id="account_journal_form_view" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <field name="default_account_id" position="after">
                <field
                    name="supplier_inv_adjustment_account_id"
                    groups="account_invoice_check_total.group_supplier_inv_adjust_total"
                    attrs="{'invisible': [('type', '!=', 'purchase')]}"
                />
            </field>
        </field>
    </record>


</odoo>
