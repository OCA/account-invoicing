<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='proforma_configuration']" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="invoice_group_by_order_partner"
                >
                    <div class="o_setting_left_pane">
                        <field name="invoice_group_by_order_partner" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="invoice_group_by_order_partner" />
                        <div class="text-muted">
                            Group invoices by order partner
                            If enabled, invoices created from multiple sale orders will be grouped only
                            when the sale partner is the same. Even if the invoice partner is the same,
                            sale orders with different sale partners will generate separate invoices.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
