<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="account_multi_discount.DiscountDistribution">
        <div
            class="o_field_discount_distribution o_field_tags d-inline-flex flex-wrap mw-100 align-items-center"
            t-att-class="{'o_tags_input o_input': !props.readonly}"
            t-ref="discountWidget"
            t-on-keydown="onWidgetKeydown"
        >
            <!-- Tags display -->
            <TagsList tags="tags" />

            <!-- Aggregated total (shown when multiple discounts) -->
            <span
                t-if="hasMultipleDiscounts"
                class="text-muted ms-1 small"
                style="white-space: nowrap;"
            >
                = <t t-esc="aggregatedDiscount" />%
            </span>

            <!-- Edit trigger -->
            <div
                t-if="!props.readonly"
                class="o_input_dropdown d-inline-flex w-100"
                tabindex="0"
                t-ref="mainElement"
                t-on-focus="onMainElementFocus"
                t-on-click="onMainElementFocus"
            >
                <span class="discount_distribution_placeholder" />
                <span class="o_dropdown_button" />

                <!-- Popup editor -->
                <t t-call="account_multi_discount.DiscountDistributionPopup" />
            </div>
        </div>
    </t>

    <t t-name="account_multi_discount.DiscountDistributionPopup">
        <div
            class="popover discount_distribution_popup dropdown-menu o-dropdown--menu show rounded py-0 overflow-x-hidden"
            t-if="state.showDropdown"
            t-ref="discountDropdown"
        >
            <!-- Header -->
            <div class="popover-header sticky-top">
                <div class="d-flex align-items-center">
                    <div class="h5 mt-2 me-auto">Discounts</div>
                    <div>
                        <span
                            class="btn o_button"
                            t-on-click.stop="() => this.forceCloseDropdown()"
                            title="Close"
                        >
                            <span class="fa fa-close" />
                        </span>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="popover-body p-2">
                <table
                    class="o_list_table table table-sm table-hover mb-2 table-striped"
                >
                    <thead>
                        <tr class="border-bottom">
                            <th class="text-center" style="width: 40px;">#</th>
                            <th>Discount (%)</th>
                            <th style="width: 30px;" />
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.discounts" t-as="disc" t-key="disc_index">
                            <td class="text-center text-muted align-middle">
                                <t t-esc="disc_index + 1" />
                            </td>
                            <td>
                                <input
                                    type="number"
                                    class="o_input w-100"
                                    step="0.01"
                                    max="100"
                                    t-att-value="disc"
                                    t-on-change="(ev) => this.onDiscountInput(disc_index, ev)"
                                />
                            </td>
                            <td class="align-middle text-center">
                                <span
                                    class="fa fa-trash-o cursor-pointer text-danger"
                                    t-on-click.stop="() => this.deleteLine(disc_index)"
                                />
                            </td>
                        </tr>

                        <!-- Add line -->
                        <tr>
                            <td
                                t-on-click.stop.prevent="addLine"
                                class="o_field_x2many_list_row_add"
                                colspan="3"
                            >
                                <a href="#">Add Discount</a>
                            </td>
                        </tr>
                    </tbody>

                    <!-- Total row -->
                    <tfoot t-if="state.discounts.length > 1">
                        <tr class="fw-bold border-top">
                            <td />
                            <td class="text-end" colspan="2">
                                Total: <t t-esc="aggregatedDiscount" />%
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>

</templates>
