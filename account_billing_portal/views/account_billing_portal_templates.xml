<odoo>
    <template
        id="portal_my_home_menu_billing"
        name="Portal layout : billing menu entries"
        inherit_id="portal.portal_breadcrumbs"
        priority="30"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'billing'"
                t-attf-class="breadcrumb-item #{'active ' if not billing else ''}"
            >
                <a t-if="billing" t-attf-href="/my/billings?{{ keep_query() }}">
                    Billings
                </a>
                <t t-else="">Billings</t>
            </li>
            <li t-if="billing" class="breadcrumb-item active">
                <t t-out="billing.name" />
            </li>
        </xpath>
    </template>

    <template
        id="portal_my_home_billing"
        name="Billings"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="30"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True" />
            <t t-set="portal_vendor_category_enable" t-value="True" />
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'" />
                <t t-set="title">Your Billings</t>
                <t t-set="url" t-value="'/my/billings?filterby=out_invoice'" />
                <t t-set="text">Follow, download or pay your billings</t>
                <t t-set="placeholder_count" t-value="'customer_bill_count'" />
            </t>
        </div>
        <div id="portal_vendor_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'" />
                <t t-set="title">Our Billings</t>
                <t t-set="url" t-value="'/my/billings?filterby=in_invoice'" />
                <t t-set="text">Follow, download or pay our billings</t>
                <t t-set="placeholder_count" t-value="'vendor_bill_count'" />
            </t>
        </div>
    </template>

    <template id="portal_my_billings" name="My Billings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Billings</t>
            </t>
            <t t-if="not billings">
                <p
                    class="alert alert-warning"
                >There are currently no billings for your account.</p>
            </t>
            <t t-if="billings" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th name="billing_number">Billing #</th>
                        <th name="billing_date">Billing Date</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="billings" t-as="billing">
                        <tr>
                            <td>
                                <a
                                    t-att-href="billing.get_portal_url()"
                                    t-att-title="billing.name"
                                >
                                    <t t-out="billing.name" />
                                </a>
                            </td>
                            <td>
                                <span t-field="billing.date" />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template
        id="portal_my_billing"
        name="Billing"
        inherit_id="portal.portal_sidebar"
        primary="True"
    >
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t
                t-set="o_portal_fullwidth_alert"
                groups="account.group_account_invoice,account.group_account_readonly"
            >
                <t t-call="portal.portal_back_in_edit_mode">
                    <t
                        t-set="backend_url"
                        t-value="('/odoo/action-account_billing.action_customer_billing/%s' % billing.id)
                                    if billing.bill_type == 'out_invoice'
                                    else ('/odoo/action-account_billing.action_supplier_billing/%s' % billing.id)"
                    />
                </t>
            </t>
            <div class="row o_portal_invoice_sidebar">
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'" />
                    <t t-set="entries">
                        <div class="d-flex flex-column gap-4 mt-3">
                            <div class="d-flex flex-column gap-2">
                                <div
                                    class="o_download_pdf d-flex flex-lg-column flex-xl-row flex-wrap gap-2"
                                >
                                    <a
                                        class="btn btn-light o_download_btn flex-grow-1"
                                        t-att-href="billing.get_portal_url(report_type='pdf', download=True)"
                                        title="Download"
                                        role="button"
                                    >
                                        <i class="fa fa-download" /> Download
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
                <div
                    id="invoice_content"
                    class="o_portal_content col-12 col-lg-8 col-xxl-9"
                >
                    <div
                        class="o_portal_html_view position-relative bg-white shadow overflow-hidden"
                    >
                        <div class="o_portal_html_loader text-center">
                            <i
                                class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"
                            />
                        </div>
                        <iframe
                            id="invoice_html"
                            class="position-relative d-block"
                            width="100%"
                            height="100%"
                            frameborder="0"
                            scrolling="no"
                            t-att-src="billing.get_portal_url(report_type='html')"
                        />
                    </div>
                    <!-- chatter -->
                    <div id="invoice_communication" class="mt-4">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread" />
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
