<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="is_utility" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']"
                position="before"
            >
                <field name="prev_unit" column_invisible="not parent.is_utility" />
                <field name="curr_unit" column_invisible="not parent.is_utility" />
                <field
                    name="utility_line_id"
                    column_invisible="not parent.is_utility"
                />
            </xpath>
        </field>
    </record>
</odoo>
