<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="account" position="inside">
                <block title="Account Utility" name="account_utility_journal_container">
                    <setting
                        id="journal_account_utility"
                        string="Account Utility Journal"
                        help="Record for the Default Journal of a Account Utility."
                    >
                        <field
                            name="journal_account_utility_id"
                            domain="[('type', '=', 'sale')]"
                        />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
