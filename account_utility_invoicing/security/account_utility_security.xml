<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="res_utility_type_multi_company_rule" model="ir.rule">
        <field name="name">Utility Type Multi-Company</field>
        <field name="model_id" ref="model_res_utility_type" />
        <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
    </record>
    <record id="res_utility_multi_company_rule" model="ir.rule">
        <field name="name">Utility Multi-Company</field>
        <field name="model_id" ref="model_res_utility" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="account_utility_rule" model="ir.rule">
        <field name="name">Account Utility Multi-Company</field>
        <field name="model_id" ref="model_account_utility" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|', ('company_id','=',False), ('company_id','in',company_ids)]
        </field>
    </record>

    <!-- Utility Group -->
    <record id="module_category_account_utility" model="ir.module.category">
        <field name="name">Utility</field>
        <field name="description">Helps you handle your utility.</field>
        <field name="sequence">15</field>
    </record>
    <record id="group_account_utility_user" model="res.groups">
        <field name="name">Utility Users</field>
        <field name="category_id" ref="module_category_account_utility" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">the user will have access to the utility.</field>
    </record>
    <record id="group_account_utility_manager" model="res.groups">
        <field name="name">Utility Manager</field>
        <field name="category_id" ref="module_category_account_utility" />
        <field name="implied_ids" eval="[(4, ref('group_account_utility_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >the user will have an access to the utility configuration.</field>
    </record>
</odoo>
