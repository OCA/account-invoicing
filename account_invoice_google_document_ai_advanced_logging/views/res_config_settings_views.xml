<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the res.config.settings form view to add the invoice mode field. -->
    <record
        id="res_config_settings_form_view_inherit_account_invoice_google_document_ai_advanced_logging"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.form.inherit.account.invoice.google.document.ai.advanced.logging</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_invoice_google_document_ai.res_config_settings_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_ocr_google_settings']" position="after">
                <!-- Add a new setting for logging OCR entities in debug mode. -->
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="log_ocr_entities_debug_setting"
                >
                    <div class="o_setting_left_pane">
                        <div class="row mt16">
                            <field
                                name="log_ocr_entities_debug"
                                class="col-lg-9 o_field_widget o_field_boolean"
                            />
                        </div>
                    </div>
                    <div class="o_setting_right_pane">
                        <span
                            class="o_form_label"
                        >Log OCR Entities as JSON in Chatter</span>
                        <div class="text-muted">
                            Enable this to log full OCR entity data as a JSON file on invoices.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
