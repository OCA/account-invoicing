<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_move_tier_validation_approver.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='require_approver_in_vendor_bills']"
                position="after"
            >
                <setting
                    id="require_approver_group_in_vendor_bills"
                    help="Require approver group before posting vendor bills. Values set here are company-specific.
                    If both options are enabled, take care to configure domains properly."
                >
                    <field name="require_approver_group_in_vendor_bills" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
