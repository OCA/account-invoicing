<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="move_form_proforma" model="ir.ui.view">
        <field name="name">move_form_proforma</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    type="object"
                    name="assign_proforma_number"
                    class="btn-link"
                    style="padding: 0px;"
                    attrs="{'invisible': ['|', ('proforma_number', '!=', False), ('state', '!=', 'draft')]}"
                    string="GENERATE PRO-FORMA"
                />
                <button
                    type="object"
                    name="print_proforma"
                    class="btn-link"
                    style="padding: 0px;"
                    attrs="{'invisible': ['|', ('proforma_number', '=', False), ('state', '!=', 'draft')]}"
                    string="PRINT PRO-FORMA"
                />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="proforma_number"
                    attrs="{'invisible': [('proforma_number', '=', False)], 'readonly': [('state', '!=', 'draft')]}"
                />
                <field
                    name="proforma_date"
                    attrs="{'invisible': [('proforma_number', '=', False)], 'readonly': [('state', '!=', 'draft')]}"
                />
            </xpath>
        </field>
    </record>
    <record id="move_tree_proforma" model="ir.ui.view">
        <field name="name">move_tree_proforma</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="proforma_number" optional="hide" />
                <field name="proforma_date" optional="hide" />
            </xpath>
        </field>
    </record>
    <record id="view_account_move_filter_proforma" model="ir.ui.view">
        <field name="name">view_account_move_filter_proforma</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="proforma_number" />
            </xpath>
        </field>
    </record>
</odoo>
