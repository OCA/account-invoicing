<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_line_tree_readonly" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Invoice Lines" create="0" edit="0" delete="0">
                <header>
                    <button
                        name="%(account_invoice_line_mass_edit.action_mass_edit_invoice_line)d"
                        type="action"
                        string="Mass Edit"
                        class="btn-primary"
                    />
                </header>
                <field name="product_id" />
                <field name="name" />
                <field name="account_id" groups="account.group_account_readonly" />
                <field
                    name="analytic_distribution"
                    string="Analytic"
                    optional="show"
                    widget="analytic_distribution"
                />
                <field name="quantity" />
                <field name="product_uom_id" groups="uom.group_uom" />
                <field name="price_unit" />
                <field name="discount" />
                <field name="tax_ids" widget="many2many_tags" />
                <field name="price_subtotal" />
                <field name="price_total" />
            </list>
        </field>
    </record>
</odoo>
