<odoo>

    <record id="account_move_form_view" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']//tree//field[@name='tax_ids']"
                position="before"
            >
                <field name="tax_domain" attrs="{'column_invisible': True}" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//tree//field[@name='tax_ids']"
                position="attributes"
            >
                <attribute name="domain">tax_domain</attribute>
            </xpath>
        </field>
    </record>



</odoo>
