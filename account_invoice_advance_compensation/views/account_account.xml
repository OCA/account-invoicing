<odoo>
    <record id="view_account_form_inherit_advance" model="ir.ui.view">
        <field name="name">account.account.form.inherit.advance</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='options_group']" position="inside">
                <field
                    name="is_advance_account"
                    string="Is Advance Account"
                    help="Mark this account for advance payment compensation"
                />
            </xpath>
        </field>
    </record>
</odoo>
