     Backport of the Odoo 19.0 CE "Purchase Matching" smart button:
     https://github.com/odoo/odoo/blob/19.0/addons/purchase/views/account_move_views.xml
     19.0 uses string-valued `invisible`; rewritten here with 16.0 `attrs`. -->
<odoo>

    <record id="view_move_form_purchase_match" model="ir.ui.view">
        <field name="name">account.move.form.purchase.match</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_purchase_matched" invisible="1" />
                <button
                    name="action_purchase_matching"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bullseye"
                    groups="purchase.group_purchase_user"
                    attrs="{'invisible': ['|', '|',
                            ('partner_id', '=', False),
                            ('move_type', 'not in', ('in_invoice', 'in_refund')),
                            ('is_purchase_matched', '=', True)]}"
                >
                    <span class="o_stat_text">Purchase<br />Matching</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
