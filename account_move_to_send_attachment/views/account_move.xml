<odoo>
    <record model="ir.ui.view" id="account_move_form_view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <page id="other_tab" position="after">
                <page
                    id="to_send_attachments"
                    name="to_send_attachments"
                    string="Attachments to send"
                >
                    <div class="alert alert-info text-center" role="status">
                        Pick the existing attachments you want to send electronically:
                    </div>
                    <group>
                        <field
                            string="Attachments"
                            name="to_be_sent_attachment_ids"
                            domain="to_be_sent_attachment_ids_domain"
                            widget="many2many_tags"
                        />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
