<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='sale_info_group']/field[@name='ref']"
                position="after"
            >
                <field
                    name="reason_id"
                    invisible="move_type != 'out_refund' and not reversed_entry_id and not reason_id"
                    readonly="not refund_reason_editable"
                />
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field
                    name="reason_id"
                    invisible="move_type not in ('in_invoice', 'in_refund') or (move_type != 'in_refund' and not reversed_entry_id and not reason_id)"
                    readonly="not refund_reason_editable"
                />
            </xpath>
        </field>
    </record>
</odoo>
