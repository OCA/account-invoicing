<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_product_name_visibility" model="ir.ui.view">
        <field name="name">account.move.form.debit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']//list/column[@name='product_and_description']"
                position="after"
            >
                <field
                    name="hide_product_name"
                    widget="boolean_toggle"
                    invisible="not name"
                    readonly="parent_state == 'posted'"
                />
            </xpath>
        </field>
    </record>
</odoo>
