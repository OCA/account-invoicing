<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_form_hide_name" model="ir.ui.view">
        <field name="name">product.template.view.form.hide_name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <field name="is_storable" position="after">
                <field
                    name="hide_product_name"
                    help="Hide the product name from line descriptions."
                />
            </field>
        </field>
    </record>
    <record id="product_view_form_hide_name" model="ir.ui.view">
        <field name="name">product.view.form.hide_name</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="is_storable" position="after">
                <field
                    name="hide_product_name"
                    help="Hide the product name from line descriptions."
                />
            </field>
        </field>
    </record>
</odoo>
