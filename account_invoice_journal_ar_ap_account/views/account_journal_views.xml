<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="inside">
                <group
                    name="ar_ap_account"
                    string="AR/AP account"
                    invisible="type not in ['sale', 'purchase']"
                >
                    <field name="ar_ap_account_domain" invisible="1" />
                    <field name="ar_ap_account_id" domain="ar_ap_account_domain" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
