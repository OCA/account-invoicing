<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_invoice_filter_inherit" model="ir.ui.view">
        <field name="name">account.invoice.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="partner_sale_id"
                    string="Sold-to"
                    filter_domain="[('partner_sale_id.name', 'ilike', self)]"
                />
            </xpath>
            <xpath expr="//filter[@name='groupy_by_partner']" position="after">
                <filter
                    string="Sold-to"
                    name="groupy_by_sale_partner"
                    domain="[]"
                    context="{'group_by': 'partner_sale_id'}"
                />
            </xpath>
        </field>
    </record>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='header_left_group']/field[@name='partner_id']"
                position="after"
            >
                <field
                    name="partner_sale_id"
                    attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"
                    string="Sold-to"
                />
            </xpath>
        </field>
    </record>
</odoo>
