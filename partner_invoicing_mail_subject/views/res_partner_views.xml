<odoo>
    <record id="view_partner_form_inherit_invoicing_mail_subject" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.invoicing.mail.subject</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_sending_method']" position="after">
                <field
                    name="invoice_email_subject"
                    placeholder="Leave empty to use the standard template subject."
                    invisible="invoice_sending_method not in 'email'"
                />
            </xpath>
        </field>
    </record>
</odoo>
