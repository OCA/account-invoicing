<odoo>

    <record
        model="ir.ui.view"
        id="account_move_line_select_purchase_line_wizard_form_view"
    >
        <field name="model">account.move.line.select.purchase.line.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    <field name="description" />
                </p>
                <group>
                    <field name="move_line_id" invisible="1" />
                    <field name="partner_id" invisible="1" />
                    <field name="product_domain" invisible="1" />
                    <field name="purchase_order_id" required="1" />
                    <field name="product_id" required="1" />
                    <field name="purchase_order_line_id" required="1" />
                </group>
                <group>
                    <group>
                        <field name="qty_received" />
                    </group>
                    <group>
                        <field name="qty_invoiced" />
                    </group>
                </group>
                <footer>
                    <button
                        name="select_purchase_line"
                        string="Select The Purchase Line"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>



</odoo>
