<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_email_traceability" model="ir.ui.view">
        <field name="name">account.move.form.email.traceability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-warning mb-0 d-flex justify-content-between align-items-center"
                    role="alert"
                    invisible="email_status != 'missing_attachment'"
                >
                    <span>
                        This invoice was recorded from an email that arrived
                        <strong>without any PDF/XML attachment</strong>.
                        Review it and, if applicable, request the sender to
                        resend the document.
                    </span>
                    <button
                        name="action_mark_email_issue_resolved"
                        type="object"
                        string="Mark as resolved"
                        class="btn btn-primary ms-2"
                    />
                </div>
                <div
                    class="alert alert-success mb-0 d-flex justify-content-between align-items-center"
                    role="alert"
                    invisible="email_status != 'resolved'"
                >
                    <span>
                        This invoice arrived <strong
                    >without a PDF/XML attachment</strong>,
                        but has already been marked as <strong>resolved</strong>.
                    </span>
                    <button
                        name="action_undo_email_issue_resolved"
                        type="object"
                        string="Undo"
                        class="btn btn-link ms-2"
                    />
                </div>

                <div
                    class="alert alert-danger mb-0"
                    role="alert"
                    invisible="not ocr_failed"
                >
                    Automatic <strong
                >digitization (OCR)</strong> of this invoice failed.
                    Review the attachment and enter the data manually if applicable.
                </div>
            </xpath>

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="email_status" invisible="1" />
                <field
                    name="email_from_raw"
                    invisible="not email_status"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>

    <record id="view_move_list_email_failed" model="ir.ui.view">
        <field name="name">account.move.list.email.failed</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Failed Invoices" create="false">
                <field name="name" />
                <field name="journal_id" />
                <field name="email_from_raw" string="Sender" />
                <field name="partner_id" string="Identified contact" />
                <field name="invoice_date" />
                <field name="state" />
                <field name="activity_ids" widget="list_activity" />
                <field name="email_status" column_invisible="1" />
                <button
                    name="action_mark_email_issue_resolved"
                    type="object"
                    string="Mark as resolved"
                    icon="fa-check"
                    invisible="email_status == 'resolved'"
                />
            </list>
        </field>
    </record>

    <record id="view_move_search_email_failed" model="ir.ui.view">
        <field name="name">account.move.search.email.failed</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="email_from_raw" string="Sender" />
                <field name="partner_id" />
                <field name="journal_id" />

                <filter
                    string="No identified contact"
                    name="no_partner"
                    domain="[('partner_id', '=', False)]"
                />

                <filter
                    string="Pending"
                    name="pending"
                    domain="[('email_status', '=', 'missing_attachment')]"
                />

                <filter
                    string="Resolved"
                    name="resolved"
                    domain="[('email_status', '=', 'resolved')]"
                />

                <group>
                    <filter
                        string="Journal"
                        name="group_journal"
                        context="{'group_by': 'journal_id'}"
                    />

                    <filter
                        string="Contact"
                        name="group_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_move_email_failed" model="ir.actions.act_window">
        <field name="name">Failed Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_move_search_email_failed" />
        <field
            name="domain"
        >[('state', '!=', 'posted'), '|', '|',('email_attachment_missing', '=', True),('ocr_failed', '=', True),('email_status', '=', 'resolved')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record
        id="action_account_move_email_failed_list_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_move_list_email_failed" />
        <field name="act_window_id" ref="action_account_move_email_failed" />
    </record>

    <menuitem
        id="menu_account_move_email_failed"
        name="Failed Invoices"
        parent="account.menu_finance_payables"
        action="action_account_move_email_failed"
        groups="account.group_account_invoice"
        sequence="90"
    />
</odoo>
