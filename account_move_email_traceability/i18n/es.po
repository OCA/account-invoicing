#. module: account_move_email_traceability
#: model_terms:ir.ui.view,arch_db:account_move_email_traceability.view_move_form_email_traceability
msgid ""
"<span>\n"
"                        This invoice arrived <strong>without a PDF/XML attachment</strong>,\n"
"                        but has already been marked as <strong>resolved</strong>.\n"
"                    </span>"
msgstr ""
"<span>\n"
"                        Esta factura llegó <strong>sin un adjunto PDF/XML</strong>,\n"
"                        pero ya fue marcada como <strong>solucionada</strong>.\n"
"                    </span>"

#. module: account_move_email_traceability
#: model_terms:ir.ui.view,arch_db:account_move_email_traceability.view_move_form_email_traceability
msgid ""
"<span>\n"
"                        This invoice was recorded from an email that arrived\n"
"                        <strong>without any PDF/XML attachment</strong>.\n"
"                        Review it and, if applicable, request the sender to\n"
"                        resend the document.\n"
"                    </span>"
msgstr ""
"<span>\n"
"                        Esta factura fue registrada a partir de un correo que llegó\n"
"                        <strong>sin ningún PDF/XML adjunto</strong>.\n"
"                        Revisar y, si corresponde, solicitar el reenvío del\n"
"                        documento al remitente.\n"
"                    </span>"

#. module: account_move_email_traceability
#: model_terms:ir.ui.view,arch_db:account_move_email_traceability.view_move_form_email_traceability
msgid ""
"Automatic <strong>digitization (OCR)</strong> of this invoice failed.\n"
"                    Review the attachment and enter the data manually if applicable."
msgstr ""
"La <strong>digitalización automática (OCR)</strong> de esta factura falló.\n"
"                    Revisar el adjunto y cargar los datos manualmente si aplica."

