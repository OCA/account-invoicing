<odoo>
    <record id="account_move_overdue_reason_view_list" model="ir.ui.view">
        <field name="name">account.move.overdue.reason.list</field>
        <field name="model">account.move.overdue.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="active" column_invisible="1" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="account_move_overdue_reason_view_form" model="ir.ui.view">
        <field name="model">account.move.overdue.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active" invisible="1" />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_move_overdue_reason_view_search" model="ir.ui.view">
        <field name="model">account.move.overdue.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                    context="{'active_test': False}"
                />
            </search>
        </field>
    </record>

    <record id="account_move_overdue_reason_action" model="ir.actions.act_window">
        <field name="name">Overdue Reasons</field>
        <field name="res_model">account.move.overdue.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="account_move_overdue_reason_menu"
        name="Overdue Reasons"
        parent="account.menu_finance_configuration"
        action="account_move_overdue_reason_action"
        sequence="95"
        groups="account.group_account_manager"
    />
</odoo>
