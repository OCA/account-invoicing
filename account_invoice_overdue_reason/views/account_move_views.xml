<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="show_overdue_reason" invisible="1" />
                <field name="overdue_reason_id" invisible="not show_overdue_reason" />
            </field>
        </field>
    </record>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="overdue_reason_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="overdue_reason_id" />
            </field>
            <xpath expr="//search/group[1]" position="inside">
                <filter
                    name="overdue_reason"
                    string="Overdue Reason"
                    context="{'group_by': 'overdue_reason_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
