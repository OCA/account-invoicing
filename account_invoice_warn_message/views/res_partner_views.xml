<odoo>
    <record id="view_partner_form_invoice_warn" model="ir.ui.view">
        <field
            name="name"
        >res.partner.form.invoice.warn (account_invoice_warn_message)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <group id="invoice_send_settings" position="after">
                <group
                    string="Invoice Warning"
                    name="invoice_warn"
                    groups="account.group_account_invoice,account.group_account_readonly"
                >
                    <field
                        name="invoice_warn_msg"
                        nolabel="1"
                        colspan="2"
                        placeholder="Warning shown on draft invoices for this partner..."
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
