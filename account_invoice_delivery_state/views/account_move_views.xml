<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============================================================
         Customer Invoices (out_invoice) – List View
         Anchor: status_in_payment is the last badge column in view_invoice_tree
         (view_out_invoice_tree inherits view_invoice_tree as primary)
    ============================================================ -->
    <record id="view_out_invoice_delivery_status_list" model="ir.ui.view">
        <field name="name">account.move.out_invoice.delivery_status.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field
                    name="delivery_status"
                    widget="badge"
                    optional="show"
                    decoration-info="delivery_status == 'pending'"
                    decoration-warning="delivery_status == 'partial'"
                    decoration-success="delivery_status == 'full'"
                />
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Vendor Bills (in_invoice) – List View
         Anchor: status_in_payment is the last badge column in view_invoice_tree
         (view_in_invoice_tree inherits view_invoice_tree as primary)
    ============================================================ -->
    <record id="view_in_invoice_receipt_status_list" model="ir.ui.view">
        <field name="name">account.move.in_invoice.receipt_status.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field
                    name="receipt_status"
                    widget="badge"
                    optional="show"
                    decoration-danger="receipt_status == 'pending'"
                    decoration-warning="receipt_status == 'partial'"
                    decoration-success="receipt_status == 'full'"
                />
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Form View – delivery_status and receipt_status badges
         Anchor: delivery_date field in the info group (line ~1545 in core)
         Both badges are hidden (invisible) when not applicable.
    ============================================================ -->
    <record id="view_move_form_delivery_status" model="ir.ui.view">
        <field name="name">account.move.form.delivery_status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_date']" position="after">
                <field
                    name="delivery_status"
                    widget="badge"
                    decoration-info="delivery_status == 'pending'"
                    decoration-warning="delivery_status == 'partial'"
                    decoration-success="delivery_status == 'full'"
                    invisible="not delivery_status"
                />
                <field
                    name="receipt_status"
                    widget="badge"
                    decoration-danger="receipt_status == 'pending'"
                    decoration-warning="receipt_status == 'partial'"
                    decoration-success="receipt_status == 'full'"
                    invisible="not receipt_status"
                />
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Customer Invoices – Search View
         Anchors verified against core view_account_invoice_filter:
           - filter name="late"  (overdue invoices)
           - filter name="invoicedate" (Group By → Invoice Date, inside <group>)
    ============================================================ -->
    <record id="view_account_invoice_filter_delivery" model="ir.ui.view">
        <field name="name">account.move.search.delivery_status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator />
                <filter
                    name="delivery_pending"
                    string="Not Delivered"
                    domain="[('delivery_status', '=', 'pending')]"
                />
                <filter
                    name="delivery_partial"
                    string="Partially Delivered"
                    domain="[('delivery_status', '=', 'partial')]"
                />
                <filter
                    name="delivery_full"
                    string="Fully Delivered"
                    domain="[('delivery_status', '=', 'full')]"
                />
            </xpath>
            <xpath expr="//filter[@name='invoicedate']" position="after">
                <filter
                    name="group_by_delivery_status"
                    string="Delivery Status"
                    context="{'group_by': 'delivery_status'}"
                />
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Vendor Bills – Search View
         view_account_bill_filter is a primary child of view_account_invoice_filter.
         It inherits all filters from the parent, so anchors late / invoicedate work.
    ============================================================ -->
    <record id="view_account_bill_filter_receipt" model="ir.ui.view">
        <field name="name">account.move.search.receipt_status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator />
                <filter
                    name="receipt_pending"
                    string="Not Received"
                    domain="[('receipt_status', '=', 'pending')]"
                />
                <filter
                    name="receipt_partial"
                    string="Partially Received"
                    domain="[('receipt_status', '=', 'partial')]"
                />
                <filter
                    name="receipt_full"
                    string="Fully Received"
                    domain="[('receipt_status', '=', 'full')]"
                />
            </xpath>
            <xpath expr="//filter[@name='invoicedate']" position="after">
                <filter
                    name="group_by_receipt_status"
                    string="Receipt Status"
                    context="{'group_by': 'receipt_status'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
