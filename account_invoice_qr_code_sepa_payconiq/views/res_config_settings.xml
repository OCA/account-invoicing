<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices']" position="after">
                <setting
                    id="payconiq_qr_profile"
                    invisible="not qr_code"
                    title="Allows to generate a qr-code for Payconiq provider containing the url."
                    string="Payconiq QR Code profile ID"
                    company_dependent="1"
                    help="Allows to generate a qr-code for Payconiq provider"
                >
                    <field name="payconiq_qr_profile_id" class="oe_inline" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
