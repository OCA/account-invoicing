<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_prepayments_demo" model="account.account">
        <field name="name">Customer Advances Demo</field>
        <field name="code">XADVDEM</field>
        <field name="account_type">asset_prepayments</field>
        <field name="reconcile">1</field>
    </record>

    <record id="journal_advance_compensation_demo" model="account.journal">
        <field name="name">Advance Demo</field>
        <field name="code">XACD</field>
        <field name="type">sale</field>
        <field name="is_advance_journal">1</field>
    </record>

    <record id="journal_advance_bank_demo" model="account.journal">
        <field name="name">Advance Bank Demo</field>
        <field name="code">XADB</field>
        <field name="type">bank</field>
    </record>

    <record id="payment_term_30_advance_demo" model="account.payment.term">
        <field name="name">30% Advance, 70% Net 30</field>
        <field
            name="line_ids"
            eval="[
                Command.clear(),
                Command.create({
                    'value': 'percent',
                    'value_amount': 30.0,
                    'nb_days': 0,
                    'is_advance': True,
                }),
                Command.create({
                    'value': 'percent',
                    'value_amount': 70.0,
                    'nb_days': 30,
                }),
            ]"
        />
    </record>

    <record id="product_category_advance_demo" model="product.category">
        <field name="name">Advance Demo</field>
        <field
            name="property_account_downpayment_categ_id"
            ref="sale_invoice_advance_compensation.account_prepayments_demo"
        />
    </record>

    <record id="product_service_advance_demo" model="product.product">
        <field name="name">Advance Service</field>
        <field name="type">service</field>
        <field name="invoice_policy">order</field>
        <field name="list_price">1000.0</field>
        <field name="taxes_id" eval="[Command.clear()]" />
        <field name="supplier_taxes_id" eval="[Command.clear()]" />
        <field
            name="categ_id"
            ref="sale_invoice_advance_compensation.product_category_advance_demo"
        />
    </record>

    <record id="partner_advance_demo" model="res.partner">
        <field name="name">Advance Customer</field>
        <field
            name="property_payment_term_id"
            ref="sale_invoice_advance_compensation.payment_term_30_advance_demo"
        />
    </record>

    <record id="sale_order_advance_demo" model="sale.order">
        <field
            name="partner_id"
            ref="sale_invoice_advance_compensation.partner_advance_demo"
        />
        <field
            name="payment_term_id"
            ref="sale_invoice_advance_compensation.payment_term_30_advance_demo"
        />
        <field
            name="advance_journal_id"
            ref="sale_invoice_advance_compensation.journal_advance_compensation_demo"
        />
        <field
            name="advance_product_id"
            ref="sale_invoice_advance_compensation.product_service_advance_demo"
        />
        <field
            name="order_line"
            eval="[
                Command.create({
                    'product_id': ref('sale_invoice_advance_compensation.product_service_advance_demo'),
                    'product_uom_qty': 1.0,
                    'price_unit': 1000.0,
                    'tax_id': [Command.clear()],
                }),
            ]"
        />
    </record>

    <function model="sale.order" name="_load_advance_compensation_demo_flow" />
</odoo>
