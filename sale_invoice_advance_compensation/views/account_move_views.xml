<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field
            name="name"
        >account.move.form.inherit.sale.invoice.advance.compensation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_sale_advance_compensations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="sale_advance_compensation_count == 0"
                >
                    <field
                        name="sale_advance_compensation_count"
                        widget="statinfo"
                        string="Compensations"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
