<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_term_view_form" model="ir.ui.view">
        <field
            name="name"
        >account.payment.term.form.inherit.sale.invoice.advance.compensation</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='value_amount']"
                position="after"
            >
                <field name="is_advance" />
            </xpath>
        </field>
    </record>
</odoo>
