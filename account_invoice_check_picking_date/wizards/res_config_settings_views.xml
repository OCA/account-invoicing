<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.account_invoice_check_picking_date</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting
                    help="Allows you to compare the accounting date and picking, taking into account the day"
                >
                    <field name="accounting_date_comparison" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
